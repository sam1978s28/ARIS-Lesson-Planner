rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Principal / Coordinator accounts (keep in sync with ADMIN_USERNAMES in firebase-config.js)
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in ['admin@alrasheed.school'];
    }

    function isActiveTeacher() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // Teacher profiles: a teacher can read only their own; only admin can create/change.
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }

    // Lesson plans: a teacher sees and edits only their own; admin sees all and writes feedback.
    match /plans/{planId} {
      allow read: if isAdmin() ||
                     (isActiveTeacher() && resource.data.teacherUid == request.auth.uid);

      allow create: if isActiveTeacher() &&
                       request.resource.data.teacherUid == request.auth.uid &&
                       request.resource.data.status in ['Draft', 'Submitted'] &&
                       request.resource.data.adminRemarks == '';

      allow update: if isAdmin() ||
                       (isActiveTeacher() &&
                        resource.data.teacherUid == request.auth.uid &&
                        request.resource.data.teacherUid == request.auth.uid &&
                        request.resource.data.status in ['Draft', 'Submitted'] &&
                        request.resource.data.adminRemarks == resource.data.adminRemarks);

      allow delete: if isActiveTeacher() && resource.data.teacherUid == request.auth.uid;
    }
  }
}
